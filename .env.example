# Server Port
PORT=5000

# Client Application URL
CLIENT_URL=http://localhost:5173

# MongoDB Connection String
# e.g., mongodb://localhost:27017/ai-coding-tutor or your MongoDB Atlas URI
MONGODB_URI=mongodb://localhost:27017/ai-coding-tutor

# Google Gemini API Key (Default AI Provider)
# Obtain free from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Selection (e.g. Gemini 3.5 Flash-Lite, gemini-2.5-flash-lite, gemini-2.0-flash-lite)
GEMINI_MODEL=Gemini 3.5 Flash-Lite



# JWT Authentication Secret & Expiration
JWT_SECRET=ai-coding-tutor-super-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# Code Execution Engine (Piston or Local Sandbox)
PISTON_API_URL=https://emkc.org/api/v2/piston

# Qwen3-4B Local Model via Ollama (Prompt Optimization & Security Guardrail)
QWEN_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
QWEN_MODEL=qwen3:4b
